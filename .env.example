# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ---- Required -----------------------------------------------------------------
# Comma-separated key pool (at least 2). Ids are assigned in order: key_1, key_2, ...
LLM_API_KEYS=your_first_api_key,your_second_api_key
# SQLite file. In Docker this is always /data/app.db on the named volume.
# Without Docker use e.g. sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the backend (your frontend URL).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true enables the X-Simulate-Failure header (must be true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true

# ---- Model --------------------------------------------------------------------
# Any LiteLLM model id: gemini/..., openai/..., groq/..., anthropic/... (all keys must belong to this provider).
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional custom endpoint (OpenAI-compatible gateways, Azure, local servers). Leave empty for the provider default.
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
DEFAULT_SYSTEM_PROMPT=You are Lyftr AI, a concise and helpful assistant.

# ---- LiteLLM response cache ---------------------------------------------------
CACHE_ENABLED=true
# disk (persists on the /data volume) or local (in-memory, cleared on restart)
CACHE_TYPE=disk
# Empty = "<directory of the SQLite file>/litellm-cache"
CACHE_DIR=

LOG_LEVEL=INFO

# ---- Frontend (build time) ----------------------------------------------------
# Public URL of the backend, baked into the static bundle. Not a secret.
VITE_API_BASE_URL=http://localhost:8000
